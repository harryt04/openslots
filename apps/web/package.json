{
  "name": "@openslots/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @openslots/react build:css && next dev",
    "dev:fake": "tsx scripts/dev-fake.ts",
    "build": "pnpm --filter @openslots/react build:css && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "create-indexes": "node --env-file-if-exists=.env.local --import tsx scripts/create-indexes.ts",
    "prod-smoke": "tsx scripts/prod-smoke.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "@openslots/core": "workspace:*",
    "@openslots/react": "workspace:*",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.73.0",
    "mongodb": "^7.9.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.450.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
