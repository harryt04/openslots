{
  "name": "@openslots/react",
  "version": "0.1.0",
  "description": "OpenSlots booking components for React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harryt04/openslots.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css",
    "./testing": "./src/testing/index.tsx"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "build:css": "node scripts/build-css.mjs",
    "dev": "node scripts/build-css.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run && vitest run --config vitest.react18.config.ts",
    "test:react18": "vitest run --config vitest.react18.config.ts"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@openslots/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "homepage": "https://github.com/harryt04/openslots#readme",
  "bugs": {
    "url": "https://github.com/harryt04/openslots/issues"
  },
  "keywords": [
    "booking",
    "appointments",
    "scheduling",
    "google-calendar",
    "react",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  }
}
