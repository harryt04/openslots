{
  "name": "@openslots/react",
  "version": "0.0.0",
  "description": "OpenSlots booking components for React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harryt04/openslots.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@openslots/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
