{
  "name": "@openslots/core",
  "version": "0.0.0",
  "description": "OpenSlots slot engine, schemas and shared types. No I/O.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harryt04/openslots.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "zod": "^4.6.7"
  }
}
