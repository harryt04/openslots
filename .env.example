# Copy to apps/web/.env.local and fill in. Never commit real values.
# Every variable is documented in docs/TRD.md section 10.

# --- Required ---------------------------------------------------------------

# MongoDB connection string. A standalone server is enough; OpenSlots does not
# use transactions. The database is named openslots-<NODE_ENV>.
MONGO_CONNECTION_STRING=mongodb://localhost:27017

# A long random string (32 characters or more), e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The public origin of this instance.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client, used for sign-in and calendar access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional ---------------------------------------------------------------

# Comma-separated emails allowed to sign in. Unset: any Google account may.
OPENSLOTS_ALLOWED_EMAILS=

# Analytics for signed-in admin pages only. Disabled unless the key is set.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Tests and local UI work only: in-memory calendar provider and a test sign-in
# at /dev/sign-in. The app refuses to start with this set in production.
# `pnpm run dev:fake` sets it for you.
# E2E_FAKE_GOOGLE=1

# Set only behind a trusted reverse proxy that REPLACES X-Forwarded-For.
# Otherwise all clients share the conservative unknown-IP rate bucket.
TRUST_PROXY_IP=0
